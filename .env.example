HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://nomada_app:CAMBIAR_PASSWORD@127.0.0.1:5432/nomada
COOKIE_SECURE=false
NODE_ENV=development
# Política de esta versión: el huésped solo cancela solicitudes pendientes.
# 0 = sin tarifa. 1000 equivale a 10 %. Acordar la regla antes de cambiarlo.
SERVICE_FEE_BPS=0
# Recuperación: configurar con una cuenta Gmail propia y contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nomada.reservaciones@gmail.com
SMTP_FROM=nomada.reservaciones@gmail.com
SMTP_PASSWORD=
