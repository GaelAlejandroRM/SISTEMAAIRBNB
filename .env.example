HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://nomada_app:CAMBIAR_PASSWORD@127.0.0.1:5432/nomada
COOKIE_SECURE=false
NODE_ENV=development
# Sin regla acordada, la cancelación de confirmadas permanece desactivada.
CANCEL_BEFORE_ARRIVAL=false
# 0 = sin tarifa. 1000 equivale a 10 %. Acordar la regla antes de cambiarlo.
SERVICE_FEE_BPS=0
